server {
    listen 80;
    server_name {{ glpi_fqdn | default('glpi.' ~ domain) }};

    root /var/www/glpi/public;
    index index.php;

    client_max_body_size 100M;

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location ~ ^/index\.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php-fpm-glpi.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 300;
    }

    # Запрет доступа к служебным каталогам GLPI
    location ~ ^/(config|files|marketplace)/ { deny all; }
}

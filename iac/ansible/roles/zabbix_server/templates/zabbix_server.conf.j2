LogType=file
LogFile=/var/log/zabbix/zabbix_server.log
PidFile=/run/zabbix/zabbix_server.pid
SocketDir=/run/zabbix

DBHost=localhost
DBName=zabbix
DBUser=zabbix
DBPassword={{ zabbix_db_password }}

StartPollers=20
StartPingers=10
StartDiscoverers=5
CacheSize=256M
HistoryCacheSize=128M
TrendCacheSize=64M

# Алерты в Telegram через webhook-скрипт
AlertScriptsPath=/usr/lib/zabbix/alertscripts

Timeout=10
LogSlowQueries=3000
